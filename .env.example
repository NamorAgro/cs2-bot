# Node.js 22.14+ (22 LTS), one persistent process on DigitalOcean.
STEAM_BOT_PASSWORD=replace-on-server
PORT=3002

# Keep the CURRENT shared CS2/Rust key when upgrading the existing bot.
BOT_API_KEY=replace-with-existing-server-key
# Optional legacy allowlist: exact origins, comma-separated, no paths or redirects.
# BOT_CALLBACK_ORIGINS=https://www.cs-store.example,https://www.rust-store.example

# Separate Dota key: use the same value as BOT_API_KEY in the Dota storefront.
# Never copy this example placeholder into production.
BOT_CLIENTS_JSON='[{"id":"dotaskin","apiKey":"replace-with-dota-store-bot-api-key","games":["dota2"],"callbackOrigins":["https://www.dotaskin.io"]}]'

# API_BASE_URL used to be required but was never used to route callbacks.
# The new configuration uses the request callback URL and per-client origins above.
